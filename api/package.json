{
  "name": "atalho-api",
  "version": "1.0.0",
  "description": "API, redirecionador e worker de cliques do Atalho",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "migrar": "node db/migrar.js",
    "semear": "node scripts/semear.js",
    "test": "node --test tests/*.test.js",
    "test:integracao": "node --test --test-concurrency=1 tests/integracao/*.test.js"
  },
  "dependencies": {
    "bullmq": "^5.34.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "ua-parser-js": "^1.0.39"
  }
}
