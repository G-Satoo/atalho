# Copie este arquivo para .env e ajuste se precisar.
# O .env fica fora do git (veja .gitignore).

# ----- Postgres -----
# Bate com o servico "db" do docker-compose.yml.
DATABASE_URL=postgres://atalho:atalho123@localhost:5435/atalho
DATABASE_SSL=false

# ----- Redis -----
# Cache, sessoes, rate limit e fila, tudo no mesmo servidor.
REDIS_URL=redis://localhost:6380

# ----- API -----
PORT=3002

# Dominio publico dos links curtos. E o que a API devolve em
# "url_curta" quando voce cria um link. Em producao vira o dominio
# de verdade (ex.: https://atl.ho).
URL_BASE=http://localhost:3002

# De onde o painel React chama a API. Usado no CORS.
ORIGEM_PAINEL=http://localhost:5174

# ----- Sessao -----
# O cookie de sessao so viaja em HTTPS quando isto e "true".
# Em desenvolvimento (http://localhost) precisa ser false.
COOKIE_SEGURO=false

# Quanto tempo uma sessao dura sem uso, em segundos (7 dias).
SESSAO_TTL=604800
